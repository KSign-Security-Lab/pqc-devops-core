prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: sdc
Description: Crypto-Agility SDK - one C API over multiple crypto libraries
Version: @PROJECT_VERSION@
Requires.private:@SDC_PC_REQUIRES@
Libs: -L${libdir} -lsdc
Cflags: -I${includedir}
